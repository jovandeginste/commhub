# Secret environment for the user service. Install as
#   ~/.config/commhub/commhub.env
# and keep it mode 0600. Values here override commhub.yaml.
#
# Generate a token with: openssl rand -hex 32
COMMHUB_API_TOKENS=replace-with-a-long-random-token

# Optional overrides:
# COMMHUB_LISTEN=127.0.0.1:8080
# COMMHUB_LOG_LEVEL=info
